ilike 1.0
// proposals written by the user; compile with lang_gaussian_posterior.ilike

algorithm mh {
  move m1 = metropolis_hastings(cpp::simulate_mh_proposal, log = cpp::evaluate_log_mh_proposal)
  termination = iterations(10000)
}

algorithm imh {
  move m1 = independent_mh(density(simulate = cpp::simulate_imh_proposal, log = cpp::log_evaluate_imh_proposal))
  termination = iterations(10000)
}

algorithm is {
  proposal = density(simulate = cpp::simulate_proposal, log = cpp::evaluate_log_prop)
}

cpp {
double proposal_sd = 1.0;
double proposal_mean = 1.0;

Parameters simulate_mh_proposal(RandomNumberGenerator &rng,
                                const Parameters &parameters) {
  arma::colvec theta(1, 1);
  theta[0] = rnorm(rng, parameters["theta"][0], proposal_sd);
  return Parameters("theta", theta);
}

double evaluate_log_mh_proposal(const Parameters &proposed_parameters,
                                const Parameters &parameters) {
  return dnorm(proposed_parameters["theta"][0], parameters["theta"][0],
               proposal_sd);
}

Parameters simulate_imh_proposal(RandomNumberGenerator &rng) {
  arma::colvec theta(1, 1);
  theta[0] = rnorm(rng, proposal_mean, proposal_sd);
  return Parameters("theta", theta);
}

double log_evaluate_imh_proposal(const Parameters &params) {
  double theta = params["theta"][0];
  return dnorm(theta, proposal_mean, proposal_sd);
}

Parameters simulate_proposal(RandomNumberGenerator &rng) {
  return Parameters("theta", rnorm(rng, proposal_mean, proposal_sd));
}

double evaluate_log_prop(const Parameters &params) {
  return dnorm(params["theta"][0], proposal_mean, proposal_sd);
}
}
