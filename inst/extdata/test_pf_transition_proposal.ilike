// Scalar linear-Gaussian state-space model as in test_kf_linear_gaussian.ilike,
// with a user-defined transition proposal N(0.9 x_{t-1}, 1) (the transition
// model has variance 0.5); the proposal functions take the data as their last
// argument.

/***data***/
Data set_data() {
  arma::colvec y(5);
  y(0) = 0.5; y(1) = 1.0; y(2) = 0.2; y(3) = -0.3; y(4) = 0.8;
  return Data("y", y);
}

/***evaluate_log_prior***/
double evaluate_log_prior(const Parameters &parameters) {
  return dnorm(parameters["x"][0], 0.0, 1.0);
}

/***simulate_prior***/
Parameters simulate_prior(RandomNumberGenerator &rng) {
  return Parameters("x", rnorm(rng, 0.0, 1.0));
}

/***linear_gaussian_transition_variable***/
std::string transition_variable() {
  return "x";
}

/***linear_gaussian_transition_matrix***/
arma::mat transition_matrix(const Parameters &parameters) {
  arma::mat A(1,1);
  A(0,0) = 0.9;
  return A;
}

/***linear_gaussian_transition_covariance***/
arma::mat transition_covariance(const Parameters &parameters) {
  arma::mat Q(1,1);
  Q(0,0) = 0.5;
  return Q;
}

/***simulate_transition_proposal***/
Parameters simulate_proposal_state(RandomNumberGenerator &rng,
                                   const Parameters &parameters,
                                   const Data &data) {
  return Parameters("x", rnorm(rng, 0.9*parameters["x"][0], 1.0));
}

/***evaluate_log_transition_proposal***/
double log_proposal_density(const Parameters &proposed_parameters,
                            const Parameters &parameters,
                            const Data &data) {
  return dnorm(proposed_parameters["x"][0], 0.9*parameters["x"][0], 1.0);
}

/***linear_gaussian_data_variable***/
std::string data_variable() {
  return "y";
}

/***linear_gaussian_data_state_variable***/
std::string state_variable() {
  return "x";
}

/***linear_gaussian_data_matrix***/
arma::mat data_matrix(const Parameters &parameters) {
  arma::mat H(1,1);
  H(0,0) = 1.0;
  return H;
}

/***linear_gaussian_data_covariance***/
arma::mat data_covariance(const Parameters &parameters) {
  arma::mat R(1,1);
  R(0,0) = 1.0;
  return R;
}

/***ssm,ilike::ssm(i,0,4,t,0,dt,1,1)***/
