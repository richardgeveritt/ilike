// Correlated built-in prior theta ~ MVN(p1, p2) on a 2-D parameter, one
// observation x = (1, 1) with likelihood N(theta, I). With IS (the prior is the
// proposal) the posterior is MVN(P^-1 (p2^-1 p1 + x), P^-1), P = p2^-1 + I.

/***prior,ilike::mvnorm(theta,p1,p2)***/

/***data***/
Data set_data() {
  arma::colvec x(2);
  x(0) = 1.0;
  x(1) = 1.0;
  return Data("x", x);
}

/***evaluate_log_likelihood***/
double evaluate_likelihood(const Parameters &params, const Data &data) {
  arma::colvec theta = params["theta"];
  arma::colvec x = data["x"];
  return dnorm(x[0], theta[0], 1.0) + dnorm(x[1], theta[1], 1.0);
}
