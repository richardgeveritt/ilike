ilike 1.0
// the inner state-space model of test_algorithmic_inner_ssm.ilike (a is the outer parameter)
model {
  x ~ norm(0, 1)
  transition x = linear_gaussian(matrix = cpp::transition_matrix, covariance = cpp::transition_covariance)
  factor obs = linear_gaussian(y, x, matrix = cpp::data_matrix, covariance = cpp::data_covariance)
  time = ssm(i, 0, 4, t, 0, dt, 1, 1)
}
cpp {
arma::mat transition_matrix(const Parameters &parameters) { arma::mat A(1,1); A(0,0) = parameters["a"][0]; return A; }
arma::mat transition_covariance(const Parameters &parameters) { arma::mat Q(1,1); Q(0,0) = 0.5; return Q; }
arma::mat data_matrix(const Parameters &parameters) { arma::mat H(1,1); H(0,0) = 1.0; return H; }
arma::mat data_covariance(const Parameters &parameters) { arma::mat R(1,1); R(0,0) = 1.0; return R; }
}
algorithm filter { particles = 500 }
