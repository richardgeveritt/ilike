ilike 1.0
// the state-space model of test_ssm_nonlinear.ilike in the ilike language
data { y = [0.5, 1.0, 0.2, -0.3, 0.8] }
model {
  prior p = density(log = cpp::evaluate_log_prior, simulate = cpp::simulate_prior)
  transition x = nonlinear_gaussian(function = cpp::transform_state, covariance = cpp::transition_covariance)
  factor obs = nonlinear_gaussian(data = y, function = cpp::transform_into_data_space, covariance = cpp::data_covariance)
  time = ssm(i, 0, 4, t, 0, dt, 1, 1)
}
cpp {
double evaluate_log_prior(const Parameters &parameters) { return dnorm(parameters["x"][0], 0.0, 1.0); }
Parameters simulate_prior(RandomNumberGenerator &rng) { return Parameters("x", rnorm(rng, 0.0, 1.0)); }
Parameters transform_state(const Parameters &parameters) { arma::colvec v(1); v[0] = 0.9*parameters["x"][0]; return Parameters("x", v); }
arma::mat transition_covariance(const Parameters &parameters) { arma::mat Q(1,1); Q(0,0) = 0.5; return Q; }
Data transform_into_data_space(const Parameters &parameters) { arma::colvec v(1); v[0] = parameters["x"][0]; return Data("y", v); }
arma::mat data_covariance(const Parameters &parameters) { arma::mat R(1,1); R(0,0) = 1.0; return R; }
}
