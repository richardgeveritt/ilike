// Metropolis proposal using a proposal parameter "sd", given through
// algorithm_parameter_list (use with test_gaussian_posterior.ilike).

/***simulate_m_proposal***/
Parameters simulate_m_proposal(RandomNumberGenerator &rng,
                               const Parameters &parameters,
                               const Parameters &proposal_parameters) {
  arma::colvec theta(1, 1);
  theta[0] = rnorm(rng, parameters["theta"][0], proposal_parameters["sd"][0]);
  return Parameters("theta", theta);
}

/***mcmc_termination,ilike::iterations(10000)***/
