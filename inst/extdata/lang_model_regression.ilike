ilike 1.0
// regression with group effects: y[i] ~ N(mu[i], sigma), mu[i] <- alpha[g[i]] + b * x[i]
data {
  y = [1.2, 0.4, 2.2, 1.9, 3.1, 0.2]
  x = [0.1, -0.5, 1.0, 0.7, 1.5, -1.0]
  g = [1, 1, 2, 2, 3, 3]
}
model {
  for (k in 1:3) alpha[k] ~ norm(0, 2)
  b ~ norm(0, 1)
  sigma ~ lnorm(0, 0.5)
  for (i in 1:6) {
    mu[i] <- alpha[g[i]] + b * x[i]
    y[i] ~ norm(mu[i], sigma)
  }
}
