ilike 1.0
// test_rforms_gaussian_posterior.ilike and test_rforms_mh_proposal.ilike in the language
data { y = r::c(1) }
model {
  prior p = density(log = r::dnorm(theta, 1, 1, log = TRUE),
                    simulate = r::list(theta = rnorm(1, 1, 1)),
                    gradient = r::prior_gradient(variable, theta))
  factor lik = density(log = r::sum(dnorm(y, theta, 1.0, log = TRUE)),
                       gradient = r::likelihood_gradient(variable, theta, data$y))
}
r {
prior_gradient = function(variable, theta) if (variable == "theta") -(theta - 1) else stop("Unknown variable in prior gradient.")
likelihood_gradient = function(variable, theta, y) if (variable == "theta") sum((y - theta)/1.0) else stop("Unknown variable in likelihood gradient.")
}
algorithm mh {
  move m1 = metropolis_hastings(r::list(theta = rnorm(1, theta, 1)), log = r::dnorm(proposed_parameters$theta, theta, 1, log = TRUE))
  termination = iterations(10000)
}
