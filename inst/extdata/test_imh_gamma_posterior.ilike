// Positive parameter with prior and independent MH proposal both gamma
// (ilike::gamma(theta,3,2)), one observation 1 with likelihood N(theta,1).

/***prior,ilike::gamma(theta,3,2)***/

/***data***/
Data set_data() {
  arma::colvec x(1);
  x(0) = 1.0;
  return Data("x", x);
}

/***evaluate_log_likelihood***/
double evaluate_likelihood(const Parameters &params, const Data &data) {
  return dnorm(data["x"][0], params["theta"][0], 1.0);
}

/***imh_proposal,ilike::gamma(theta,3,2)***/

/***mcmc_termination,ilike::iterations(10000)***/
