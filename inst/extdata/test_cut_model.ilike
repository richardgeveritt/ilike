// A small Gaussian version of the cut model in Plummer (2015), "Cuts in
// Bayesian graphical models", Stat Comput 25:37-43, Fig. 1:
//   phi ~ N(0, 1),  z | phi ~ N(phi, 1),
//   theta ~ N(0, 1),  y | theta, phi ~ N(theta + phi, 1),
// observed z = 2, y = 3.
// Factors (in file order): 1 p(phi), 2 p(z | phi), 3 p(theta), 4 p(y | theta, phi).
//
// Cut distribution p*(theta, phi) = p(theta | y, phi) p(phi | z):
//   phi ~ N(z/2, 1/2) = N(1, 1/2);
//   theta | phi ~ N((y - phi)/2, 1/2), so theta has mean (y - z/2)/2 = 1 and
//   variance 1/2 + 1/8 = 5/8.
// Full posterior, for comparison: phi mean 1.4, var 0.4; theta mean 0.8, var 0.6.

/***data***/
Data set_data() {
  arma::colvec x(2);
  x(0) = 2.0; // z
  x(1) = 3.0; // y
  return Data("x", x);
}

/***evaluate_log_prior***/
double evaluate_log_prior_phi(const Parameters &params) {
  return dnorm(params["phi"][0], 0.0, 1.0);
}

/***simulate_prior***/
Parameters simulate_prior_phi(RandomNumberGenerator &rng) {
  return Parameters("phi", rnorm(rng, 0.0, 1.0));
}

/***evaluate_log_likelihood***/
double evaluate_likelihood_z(const Parameters &params, const Data &data) {
  return dnorm(data["x"][0], params["phi"][0], 1.0);
}

/***evaluate_log_prior***/
double evaluate_log_prior_theta(const Parameters &params) {
  return dnorm(params["theta"][0], 0.0, 1.0);
}

/***simulate_prior***/
Parameters simulate_prior_theta(RandomNumberGenerator &rng) {
  return Parameters("theta", rnorm(rng, 0.0, 1.0));
}

/***evaluate_log_likelihood***/
double evaluate_likelihood_y(const Parameters &params, const Data &data) {
  return dnorm(data["x"][1], params["theta"][0] + params["phi"][0], 1.0);
}
