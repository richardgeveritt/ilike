// SMC with MCMC moves, annealing with the next power chosen to give a
// conditional effective sample size of 0.95 times the number of particles.
// Use with test_gaussian_posterior.ilike.

/***m_proposal,ilike::norm_rw(theta,1)***/

/***mcmc_termination,ilike::iterations(5)***/

/***smc_sequence,ilike::annealing(power,c(0,1))***/

/***adaptive_target,ilike::cess(0.95)***/
